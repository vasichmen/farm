{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "assets:sync": "node scripts/sync-handoff-assets.mjs",
        "icons:build": "node scripts/build-icons.mjs",
        "build": "npm run icons:build && vite build",
        "dev": "vite",
        "predev": "npm run icons:build",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint . && prettier --check .",
        "format": "eslint . --fix && prettier --write .",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "vue": "^3.5.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource/cormorant-garamond": "^5.3.0",
        "@fontsource/manrope": "^5.3.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "fontaine": "^0.8.2",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.10",
        "svgo": "^4.1.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.0.0",
        "vue-tsc": "^3.0.0"
    }
}
